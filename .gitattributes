# Normalizza i fine riga: tutti i file di testo vengono salvati con LF nel repository
# e restano LF anche al checkout, indipendentemente dal sistema operativo o dalle
# impostazioni locali di core.autocrlf. Elimina i "falsi modificati" causati da CRLF/LF.
* text=auto eol=lf

# File di testo espliciti (ridondante con la regola sopra, ma esplicito e sicuro)
*.md text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# File binari: nessuna conversione, per sicurezza anche se già auto-rilevati
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
